PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AXIOS_TIMEOUT_MS=5000
ANOMALY_SERVICE_URL=http://localhost:8001
ANALYTICS_SERVICE_URL=http://localhost:8002

# --- Supabase (FairGig project) ---
# Dashboard → Project Settings → API: https://supabase.com/dashboard/project/cylloibqpsqqcesmsigg/settings/api
SUPABASE_URL=https://cylloibqpsqqcesmsigg.supabase.co
# "anon" / "publishable" key — safe for browser with RLS; use in Node only if you intentionally use user JWTs
SUPABASE_ANON_KEY=
# "service_role" — bypasses RLS; server-side only, never expose to frontend or commit
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct Postgres (SQL tools, Prisma, etc.) — Database → Connection string
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-DB-PASSWORD]@...
