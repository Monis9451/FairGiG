# Local default. On Railway, omit PORT from Variables — the platform sets $PORT (e.g. 8080).
# If you force PORT here to 5000 in Railway, public URLs often return 502 while healthchecks still pass.
PORT=5000
# Railway/Docker: bind address (default 0.0.0.0). Rarely need to change.
# HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5000
AXIOS_TIMEOUT_MS=5000

# --- Railway: one Node service + INLINE_NODE_SERVICES=1 ---
# Railway → Service → Settings → Root Directory: leave EMPTY (clone whole repo).
# Do NOT set Root Directory to service-api-gateway-node only — healthcheck will fail.
# Omit AUTH_/GRIEVANCE_/ANALYTICS_/CERTIFICATES_ SERVICE_URL when using this.
# INLINE_NODE_SERVICES=1

# Node microservices (reverse-proxied when INLINE_NODE_SERVICES is not set).
AUTH_SERVICE_URL=http://localhost:5010
GRIEVANCE_SERVICE_URL=http://localhost:5011
ANALYTICS_SERVICE_URL=http://localhost:5012
CERTIFICATES_SERVICE_URL=http://localhost:5013

# BFF proxy targets (Python; server-side only).
ANOMALY_SERVICE_URL=http://localhost:8001
EARNINGS_SERVICE_URL=http://localhost:8000
# BFF → Python socket timeout (ms). Fails with JSON 502 instead of hanging until a gateway 504.
DOWNSTREAM_PROXY_TIMEOUT_MS=120000
SEED_VERIFIED_EARNINGS_COUNT=1000

# Cloudinary upload settings (used by /api/uploads/shift-screenshot)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=fairgig/shift-screenshots
CLOUDINARY_MAX_UPLOAD_MB=5
CLOUDINARY_ALLOWED_FORMATS=jpg,jpeg,png,webp

